NODE_ENV=development
PORT=3000
APP_NAME=Bookly API
API_VERSION=v1
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/bookly
MONGODB_DNS_SERVERS=
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
API_DOCS_ENABLED=true
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000

JWT_ACCESS_TOKEN_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_NAME=bookly_refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

OTP_LENGTH=4
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFICATION_ATTEMPTS=5
OTP_MAX_RESENDS_PER_HOUR=5
OTP_HASH_SECRET=change-me-to-a-random-32-plus-character-otp-secret
REGISTRATION_SESSION_TTL_HOURS=24
OTP_PROVIDER=dummy
DUMMY_PHONE_OTP_CODE=1234

EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Bookly
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Bookly

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

STORAGE_PROVIDER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=bookly-business-media
S3_ACCESS_KEY_ID=change-me-minio-access-key
S3_SECRET_ACCESS_KEY=change-me-minio-secret-key
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
BUSINESS_MEDIA_MAX_UPLOAD_BYTES=5242880
BUSINESS_MEDIA_SIGNED_URL_TTL_SECONDS=900
# Staff avatar endpoint only; read URLs reuse BUSINESS_MEDIA_SIGNED_URL_TTL_SECONDS above.
STAFF_AVATAR_MAX_UPLOAD_BYTES=5242880

# Stripe TEST-mode credentials. NOT configured in this repository as of Batch 4 — obtain your
# own from https://dashboard.stripe.com/test/apikeys (secret + publishable keys) and, for the
# webhook secret, run `stripe listen --forward-to localhost:3000/api/v1/payments/webhooks/stripe`
# (Stripe CLI) locally, which prints a `whsec_...` value to use here. Leaving these unset is safe
# in development/test — the payment gateway raises a clear, typed error only when a real charge
# is actually attempted; the app still boots and every non-payment test still passes.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NO_SHOW_WORKER_POLL_INTERVAL_MS=60000
NO_SHOW_WORKER_BATCH_SIZE=50

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

AUTH_ENTRY_RATE_LIMIT_MAX=20
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_OTP_SEND_RATE_LIMIT_MAX=5
AUTH_OTP_VERIFY_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_MAX=30
BUSINESS_LINK_OTP_SEND_RATE_LIMIT_MAX=5
BUSINESS_LINK_OTP_SEND_PER_EMAIL_RATE_LIMIT_MAX=5
