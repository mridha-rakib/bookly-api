NODE_ENV=development
PORT=3000
APP_NAME=Bookly API
API_VERSION=v1
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/bookly
MONGODB_DNS_SERVERS=
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
API_DOCS_ENABLED=true
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000

JWT_ACCESS_TOKEN_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_NAME=bookly_refresh_token
# Set to the parent domain (e.g. .bookly.cy) only when the API and web app live on different
# subdomains and must share the refresh cookie. Leave blank for host-only cookies (local dev).
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/api/v1/auth
# Defaults to true when NODE_ENV=production. Must be true whenever AUTH_COOKIE_SAME_SITE=none.
AUTH_COOKIE_SECURE=false
# "lax" (default) — required so the refresh + OAuth-nonce cookies survive Google's top-level
# redirect back to the callback. Use "none" ONLY for a cross-site frontend/backend split, and
# then AUTH_COOKIE_SECURE MUST be true (the app refuses to boot otherwise).
AUTH_COOKIE_SAME_SITE=lax

# EMAIL OTP digit count (Bookly generates these). Kept at 4 — see PHONE_OTP_CODE_LENGTH below.
OTP_LENGTH=4
# SMS OTP digit count (Twilio Verify). 4–10; default 6. MUST match the Twilio Verify Service
# "Code Length" setting (Twilio Console -> Verify -> Services -> <service> -> Settings).
PHONE_OTP_CODE_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFICATION_ATTEMPTS=5
OTP_MAX_RESENDS_PER_HOUR=5
OTP_HASH_SECRET=change-me-to-a-random-32-plus-character-otp-secret
REGISTRATION_SESSION_TTL_HOURS=24
OTP_PROVIDER=dummy
# Dev-only fixed SMS code (OTP_PROVIDER=dummy). Must be exactly PHONE_OTP_CODE_LENGTH digits.
DUMMY_PHONE_OTP_CODE=123456

# smtp | resend | sendgrid. Dev default: smtp. Production default (when unset): sendgrid.
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Bookly
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Bookly

# SendGrid is the provider this project uses in production (EMAIL_PROVIDER defaults to "sendgrid"
# when NODE_ENV=production). It uses EMAIL_FROM/EMAIL_FROM_NAME above as its sender identity (no
# separate pair). With EMAIL_PROVIDER=sendgrid, SENDGRID_API_KEY and EMAIL_FROM are required at boot.
SENDGRID_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Twilio MESSAGING Service SID (starts "MG...") — sender for appointment-reminder SMS. NOT the
# Verify SID above. Optional: leave blank unless you run the SMS worker (pnpm worker:sms).
TWILIO_MESSAGING_SERVICE_SID=

STORAGE_PROVIDER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=bookly-business-media
S3_ACCESS_KEY_ID=change-me-minio-access-key
S3_SECRET_ACCESS_KEY=change-me-minio-secret-key
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
BUSINESS_MEDIA_MAX_UPLOAD_BYTES=5242880
BUSINESS_MEDIA_SIGNED_URL_TTL_SECONDS=900
# Staff avatar endpoint only; read URLs reuse BUSINESS_MEDIA_SIGNED_URL_TTL_SECONDS above.
STAFF_AVATAR_MAX_UPLOAD_BYTES=5242880
# Customer self-service avatar endpoint (PUT /auth/me/avatar) only.
CUSTOMER_AVATAR_MAX_UPLOAD_BYTES=5242880

# Stripe TEST-mode credentials. NOT configured in this repository as of Batch 4 — obtain your
# own from https://dashboard.stripe.com/test/apikeys (secret + publishable keys) and, for the
# webhook secret, run `stripe listen --forward-to localhost:3000/api/v1/payments/webhooks/stripe`
# (Stripe CLI) locally, which prints a `whsec_...` value to use here. Leaving these unset is safe
# in development/test — the payment gateway raises a clear, typed error only when a real charge
# is actually attempted; the app still boots and every non-payment test still passes.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NO_SHOW_WORKER_POLL_INTERVAL_MS=60000
NO_SHOW_WORKER_BATCH_SIZE=50

# Canonical public URL of the Bookly web app (separate repo, deploys independently). Used to
# build transactional-email links (/privacy, /terms-of-use, ...). Never derived from
# CORS_ORIGINS. Dev default is the local frontend; production MUST override with a public https URL.
FRONTEND_BASE_URL=http://localhost:3000

# Marketing Email M2/M3B — the API's OWN public base URL incl. the /api/<version> prefix. ONLY
# used to build the RFC 8058 one-click List-Unsubscribe header target, which mail providers POST
# to directly (so it must resolve to the API, not the web app). Same "configured directly" style
# as GOOGLE_CALENDAR_REDIRECT_URI. Optional in dev/test (the campaign worker just omits the
# one-click headers and fails the campaign); **REQUIRED in production** — the API refuses to boot
# without it. Dev default matches the local API; production MUST override with a real https URL.
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# Marketing Email Stage M2 — public unsubscribe endpoint per-IP rate limit (15-min window).
MARKETING_RATE_LIMIT_MAX=20
# Marketing Email Stage M3B — campaign delivery worker (pnpm worker:marketing). Concurrency is
# deliberately lower than transactional email — a bulk blast must not hammer the provider.
MARKETING_WORKER_POLL_INTERVAL_MS=30000
MARKETING_WORKER_BATCH_SIZE=50
MARKETING_WORKER_CONCURRENCY=3
MARKETING_WORKER_MAX_ATTEMPTS=4
MARKETING_WORKER_RETRY_BASE_MS=60000
MARKETING_WORKER_CLAIM_TIMEOUT_MS=120000
MARKETING_WORKER_PROMOTE_BATCH_SIZE=5

# Transactional-email outbox worker (pnpm worker:email / worker:email:once). OTP is never queued.
EMAIL_WORKER_POLL_INTERVAL_MS=5000
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_WORKER_CONCURRENCY=5
EMAIL_WORKER_MAX_ATTEMPTS=5
EMAIL_WORKER_RETRY_BASE_MS=60000
EMAIL_OUTBOX_CLAIM_TIMEOUT_MS=120000

# 24h appointment-reminder worker (pnpm worker:reminder / worker:reminder:once). Schedules the
# reminder email into the EmailOutbox above; SendGrid delivery is unchanged. MAX_ATTEMPTS bounds
# reminder orchestration retries only (provider retries stay with the email outbox).
APPOINTMENT_REMINDER_WORKER_POLL_INTERVAL_MS=60000
APPOINTMENT_REMINDER_WORKER_BATCH_SIZE=50
APPOINTMENT_REMINDER_WORKER_CONCURRENCY=5
APPOINTMENT_REMINDER_WORKER_MAX_ATTEMPTS=5
APPOINTMENT_REMINDER_WORKER_CLAIM_TIMEOUT_MS=120000

# Transactional-SMS outbox worker (pnpm worker:sms / worker:sms:once). Needs
# TWILIO_MESSAGING_SERVICE_SID above. Unused until Stage 3B wires reminder SMS.
SMS_WORKER_POLL_INTERVAL_MS=15000
SMS_WORKER_BATCH_SIZE=20
SMS_WORKER_CONCURRENCY=5
SMS_WORKER_MAX_ATTEMPTS=5
SMS_WORKER_RETRY_BASE_MS=60000
SMS_OUTBOX_CLAIM_TIMEOUT_MS=120000

# Google OAuth 2.0 Client (Web application) — powers ALL Google flows: account linking, Customer
# / Business-Owner / Staff "Continue with Google", and Calendar sync. Create it at
# https://console.cloud.google.com/apis/credentials, enable the Google Calendar API, request the
# openid/email/profile (+ calendar.events) scopes, and register EVERY redirect URI below as an
# "Authorized redirect URI" on this one client.
#   PRODUCTION: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and all five *_REDIRECT_URI vars below are
#   REQUIRED — the app refuses to boot without them.
#   DEV/TEST: leave them unset; each feature's is*Configured() gate keeps the app booting and the
#   flow returns a clear NOT_CONFIGURED error / status=error redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/v1/businesses/integrations/google-calendar/callback
# (matches PORT above; api-router mounts this module at /businesses/integrations/google-calendar)
# 32-byte AES-256-GCM key, hex-encoded. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Customer -> Google account linking (linked-account module): OIDC scopes only (openid / email /
# profile). Register this as a SECOND "Authorized redirect URI" on the same OAuth client. No
# token-encryption key — linking stores no OAuth tokens. Unset is safe in dev/test.
GOOGLE_ACCOUNT_LINK_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback
# Customer "Continue with Google" sign-up / sign-in (customer-google-auth module): OIDC scopes
# only. Register as a further "Authorized redirect URI" on the same OAuth client. Unset is safe
# in dev/test (the start endpoint just redirects back with status=error).
GOOGLE_CUSTOMER_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/customer/oauth/google/callback
# Business Owner "Continue with Google" (professional-google-auth module): OIDC scopes only.
# Register as a further "Authorized redirect URI" on the same OAuth client. Unset is safe in
# dev/test (the start endpoint redirects back with status=error).
GOOGLE_PROFESSIONAL_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/professional/oauth/google/callback
# Staff/Supervisor invitation acceptance via Google (Phase 2D, staff-invitation module): OIDC
# scopes only. Register as a further "Authorized redirect URI" on the same OAuth client. Unset is
# safe in dev/test (the start endpoint redirects back with status=error).
GOOGLE_STAFF_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/staff/invitation/oauth/google/callback

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=

# Local-development-only demo CUSTOMER (pnpm seed:demo-customer). Blank here by convention;
# set real values in your local .env. The seed refuses to run when NODE_ENV=production.
# Suggested local values: DEMO_CUSTOMER_EMAIL=demo.customer@bookly.local
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
DEMO_CUSTOMER_FIRST_NAME=
DEMO_CUSTOMER_LAST_NAME=

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

AUTH_ENTRY_RATE_LIMIT_MAX=20
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_OTP_SEND_RATE_LIMIT_MAX=5
AUTH_OTP_VERIFY_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_MAX=30
BUSINESS_LINK_OTP_SEND_RATE_LIMIT_MAX=5
BUSINESS_LINK_OTP_SEND_PER_EMAIL_RATE_LIMIT_MAX=5
