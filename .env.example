NODE_ENV=development
PORT=3000
APP_NAME=Bookly API
API_VERSION=v1
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/bookly
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
API_DOCS_ENABLED=true
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
