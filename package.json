{
  "name": "bookly-api",
  "version": "0.1.0",
  "description": "Bookly backend API foundation",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "start": "node dist/app/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration/database --pool=forks --fileParallelism=false",
    "seed:super-admin": "tsx src/scripts/seed-super-admin.ts",
    "seed:demo-customer": "tsx src/scripts/seed-demo-customer.ts",
    "sync:indexes": "tsx src/scripts/sync-indexes.ts",
    "worker:no-show": "tsx src/scripts/run-no-show-worker.ts",
    "worker:no-show:once": "tsx src/scripts/run-no-show-worker.ts --once",
    "worker:email": "tsx src/scripts/run-email-worker.ts",
    "worker:email:once": "tsx src/scripts/run-email-worker.ts --once",
    "worker:reminder": "tsx src/scripts/run-appointment-reminder-worker.ts",
    "worker:reminder:once": "tsx src/scripts/run-appointment-reminder-worker.ts --once",
    "worker:sms": "tsx src/scripts/run-sms-worker.ts",
    "worker:sms:once": "tsx src/scripts/run-sms-worker.ts --once",
    "prepare": "node scripts/prepare-husky.mjs"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@sendgrid/mail": "^8.1.6",
    "@t3-oss/env-core": "^0.13.11",
    "argon2": "^0.45.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "luxon": "^3.7.2",
    "mongoose": "^9.8.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.20.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.18.1",
    "sanitize-html": "^2.17.7",
    "stripe": "^22.5.0",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.4",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "mongodb-memory-server-core": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
